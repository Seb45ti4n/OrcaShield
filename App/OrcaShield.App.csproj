<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>OrcaShield</AssemblyName>
    <RootNamespace>OrcaShield</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Orca.ico</ApplicationIcon>

    <Product>OrcaShield</Product>
    <Title>OrcaShield</Title>
    <Description>Datenschutz für Windows 11</Description>
    <Company>OrcaShield</Company>
    <Copyright>OrcaShield-Mitwirkende</Copyright>
    <Version>1.1.0-beta</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0 Public Beta</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Keine Debug-Datei und keine Pfade des Bau-Rechners in der EXE (sonst stünde dort
         der vollständige Pfad der .pdb-Datei, also der Ordner, in dem gebaut wurde) -->
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <!-- Zwischen- und Ausgabeordner beider Bauarten nie als Quelltext einlesen -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**;Ausgabe\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Nur zum Übersetzen: Zur Laufzeit gilt die Windows PowerShell 5.1 des Systems (GAC),
         deshalb wird nichts davon mitkopiert. -->
    <PackageReference Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" ExcludeAssets="all" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <!-- JSON für die Brücke: Teil von .NET Framework, nichts mitzuliefern -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management.Automation">
      <HintPath>$(PkgMicrosoft_PowerShell_5_1_ReferenceAssemblies)\lib\net461\System.Management.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Oberfläche und Skripte liegen neben der EXE (wie später im Programmordner). -->
  <ItemGroup>
    <None Include="..\Werkzeuge\Gui\OrcaShield.html" Link="Gui\OrcaShield.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Werkzeuge\Gui\orca-texte-en.js" Link="Gui\orca-texte-en.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Skripte\*.ps1" Link="Skripte\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Skripte\Orca-Hosts.txt" Link="Skripte\Orca-Hosts.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Readme.txt" Link="Readme.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
